<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KletternRoutenApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="KletternRoutenApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="KletternRoutenApp"
        Width="650" Height="550"
        Background="{StaticResource PageBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top"
                   Text="🧗 Meine Kletterrouten"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0 0 0 16" />

                
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0 0 0 20">
            <TextBox Watermark="Neue Kletterroute..."
                    Text="{Binding NewItemContent}" />

            
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                        Watermark="Gym / Kletterhalle"
                        Text="{Binding NewItemGym}" />

                <ComboBox Grid.Column="1"
                        PlaceholderText="Schwierigkeitsgrad"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding SchwierigkeitsgradOptions}"
                        SelectedItem="{Binding NewItemSchwierigkeitsgrad}" />
            </Grid>

           
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <DatePicker Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            SelectedDate="{Binding NewItemDatum}" />

                <Button Grid.Column="1"
                        Content="Hinzufügen"
                        Command="{Binding AddItemCommand}" />
            </Grid>
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ToDoItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KletterRoutenViewModel">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0 0 0 8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Löschen"
                                        Background="Transparent"
                                        Foreground="#C62828"
                                        FontWeight="Normal"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteItemCommand}"
                                        CommandParameter="{Binding}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Content}"
                                                Foreground="{StaticResource TextBrush}"
                                                FontWeight="SemiBold"
                                                FontSize="15" />

                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="28 0 0 0">
                                        <TextBlock Text="{Binding Gym, StringFormat='🏢 {0}'}"
                                                   FontSize="12" Foreground="#757575" />
                                        <TextBlock Text="{Binding Schwierigkeitsgrad, StringFormat='📊 Grad {0}'}"
                                                   FontSize="12" Foreground="#757575" />
                                        <TextBlock Text="{Binding Datum, StringFormat='📅 {0:dd.MM.yyyy}'}"
                                                   FontSize="12" Foreground="#757575" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</Window>