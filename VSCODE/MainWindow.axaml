<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KletternRoutenApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="KletternRoutenApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="KletternRoutenApp"
        Width="600" Height="500"
        Background="{StaticResource PageBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top"
                   Text="Kletterrouten"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0 0 0 16" />

        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0 0 0 20">
            <TextBox Width="320"
                     Watermark="Neue Kletterroute..."
                     Text="{Binding NewItemContent}" />
            <Button Content="Hinzufügen"
                    Command="{Binding AddItemCommand}" />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ToDoItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KletterRoutenViewModel">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0 0 0 8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Löschen"
                                        Background="Transparent"
                                        Foreground="#C62828"
                                        FontWeight="Normal"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteItemCommand}"
                                        CommandParameter="{Binding}" />
                                <CheckBox Content="{Binding Content}"
                                          IsChecked="{Binding IsChecked}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="15" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</Window>